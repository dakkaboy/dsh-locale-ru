{
  "name": "dsh-locale-ru",
  "version": "1.1.0",
  "description": "Русская локализация веб-интерфейса DeepSeek Harness: 2737 строк в 64 разделах",
  "keywords": [
    "deepseek",
    "dsh",
    "localization",
    "i18n",
    "russian",
    "locale",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dakkaboy/dsh-locale-ru.git"
  },
  "homepage": "https://github.com/dakkaboy/dsh-locale-ru#readme",
  "bugs": {
    "url": "https://github.com/dakkaboy/dsh-locale-ru/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
